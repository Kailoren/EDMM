# This repo shares its parent folder with unrelated sibling projects, so ignore
# everything at the top level and opt EDMM's own files back in. Any new subfolder
# added to the folder is then ignored automatically.
/*
!/.gitignore
!/LICENSE
!/README.md
!/package.json
!/package-lock.json
!/rollup.config.mjs
!/tsconfig.json
!/scripts/
!/src/
!/com.kailo.edminingbook.sdPlugin/

# Leftovers inside the project's own folders
node_modules/
com.kailo.edminingbook.sdPlugin/logs/
*.bak
